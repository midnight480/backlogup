{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["major", "minor", "patch"],
      "minimumReleaseAge": "3 days"
    }
  ],
  "labels": ["dependencies"],
  "vulnerabilityAlerts": {
    "labels": ["security", "dependencies"]
  }
}
