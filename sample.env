# Backlogのドメイン (バックアップ元)
BACKLOG_HOST=hogehoge.backlog.com

# BacklogのAPIキー（個人設定→API から取得できます）
BACKLOG_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXX

# Backlogのプロジェクトキー
BACKLOG_PROJECT_KEY=PROJ_HOGE

# ========================================
# 移行先 (Target Space) の設定
# ========================================
TARGET_BACKLOG_HOST=target.backlog.com
TARGET_BACKLOG_API_KEY=YYYYYYYYYYYYYYYYYYYYYYYYYYY
TARGET_BACKLOG_PROJECT_KEY=TARGET_PROJ

# 移行先プロジェクトにすでに課題が存在する場合に登録を継続する場合は true に設定します
ALLOW_EXISTING_ISSUES=false

