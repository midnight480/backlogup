# ========================================
# バックアップ元 (Source Space) の設定 / Source Space Settings
# ========================================

# Backlogのドメイン / Backlog domain (e.g. xxx.backlog.com)
BACKLOG_HOST=hogehoge.backlog.com

# BacklogのAPIキー（個人設定→API から取得できます） / Backlog API Key (Personal Settings -> API)
BACKLOG_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXX

# Backlogのプロジェクトキー / Backlog Project Key
BACKLOG_PROJECT_KEY=PROJ_HOGE

# ========================================
# 移行先 (Target Space) の設定 / Target Space Settings
# ========================================

# 移行先のBacklogドメイン / Target Backlog domain
TARGET_BACKLOG_HOST=target.backlog.com

# 移行先のBacklog APIキー / Target Backlog API Key
TARGET_BACKLOG_API_KEY=YYYYYYYYYYYYYYYYYYYYYYYYYYY

# 移行先のプロジェクトキー / Target Backlog Project Key
TARGET_BACKLOG_PROJECT_KEY=TARGET_PROJ

# 移行先プロジェクトにすでに課題が存在する場合でも登録を継続する場合は true に設定（既定値: false）
# Set to true if you want to proceed even if issues already exist in the target project (default: false)
ALLOW_EXISTING_ISSUES=false
